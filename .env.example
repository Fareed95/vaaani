# Runtime
VAAANI_ENVIRONMENT=development
VAAANI_LOG_LEVEL=INFO
VAAANI_API_HOST=0.0.0.0
VAAANI_API_PORT=8000
VAAANI_CORS_ORIGINS=http://localhost:3000

# Qdrant. Use :memory: for a zero-dependency local API process.
VAAANI_QDRANT_URL=http://localhost:6333
VAAANI_QDRANT_API_KEY=
VAAANI_QDRANT_COLLECTION=vaaani_passages

# Retrieval and ingestion
VAAANI_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
VAAANI_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
VAAANI_NLI_MODEL=cross-encoder/nli-deberta-v3-small
VAAANI_CHUNK_STRATEGY=metadata
VAAANI_CHUNK_SIZE=256
VAAANI_CHUNK_OVERLAP=0.2
VAAANI_CONFIDENCE_THRESHOLD=0.40
VAAANI_LANGUAGES=en,hi
VAAANI_DATASET_NAME=ai4bharat/MSMARCO-XI
VAAANI_DATASET_SPLIT=train
VAAANI_DATASET_LIMIT=1000
VAAANI_ENABLE_ML_MODELS=false

# Sarvam AI (https://docs.sarvam.ai/)
VAAANI_SARVAM_API_KEY=
VAAANI_SARVAM_BASE_URL=https://api.sarvam.ai
VAAANI_SARVAM_STT_MODEL=saaras:v3
VAAANI_SARVAM_TTS_MODEL=bulbul:v3
VAAANI_SARVAM_TTS_SPEAKER=shubh

# OpenAI-compatible generation endpoint
VAAANI_LLM_API_KEY=
VAAANI_LLM_BASE_URL=https://api.openai.com/v1
VAAANI_LLM_MODEL=gpt-4.1-mini

# Browser application
NEXT_PUBLIC_API_URL=http://localhost:8000
